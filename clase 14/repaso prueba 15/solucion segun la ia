-- Ejercicio 20: Vista compleja detalle de plantas con INNER JOIN
DROP VIEW IF EXISTS v_planta_detalle;
CREATE VIEW v_planta_detalle AS
SELECT p.codigo, p.nombre, c.nombre AS categoria, p.precio, p.stock, p.tipo_luz
FROM t_planta p
INNER JOIN t_categoria c ON p.categoria_id = c.id;

SELECT *
FROM v_planta_detalle
WHERE categoria = 'Árboles nativos'
ORDER BY precio DESC;

-- Ejercicio 21: Vista compleja detalle de ventas uniendo 4 tablas
DROP VIEW IF EXISTS v_venta_detalle;
CREATE VIEW v_venta_detalle AS
SELECT v.id AS venta, v.fecha_hora,
       cl.nombre AS cliente_nombre, cl.apellido AS cliente_apellido, cl.ciudad,
       p.nombre AS planta, e.nombre AS vendedor,
       v.cantidad, v.precio_unitario,
       (v.cantidad * v.precio_unitario) AS total
FROM t_venta v
INNER JOIN t_cliente cl ON v.cliente_id = cl.id
INNER JOIN t_planta p ON v.planta_id = p.id
INNER JOIN t_empleado e ON v.empleado_id = e.id;

SELECT * FROM v_venta_detalle;

-- Ejercicio 22: Consulta sobre v_venta_detalle filtrando por Temuco
SELECT venta, fecha_hora, cliente_nombre, cliente_apellido, planta, total
FROM v_venta_detalle
WHERE ciudad = 'Temuco'
ORDER BY total DESC;

-- Ejercicio 23: Desafío opcional - Ventas agrupadas por vendedor
DROP VIEW IF EXISTS v_venta_por_vendedor;
CREATE VIEW v_venta_por_vendedor AS
SELECT e.nombre, e.apellido, 
       COUNT(*) AS cantidad_ventas, 
       SUM(v.cantidad * v.precio_unitario) AS monto_total
FROM t_venta v 
INNER JOIN t_empleado e ON v.empleado_id = e.id
GROUP BY e.id, e.nombre, e.apellido;

SELECT * FROM v_venta_por_vendedor ORDER BY monto_total DESC;

