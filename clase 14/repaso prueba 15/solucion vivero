FROM v_venta_detalle
WHERE ciudad = 'Temuco'
ORDER BY total DESC;


-- Ejercicio 23 (Desafío opcional)
-- Cree la vista v_venta_por_vendedor con nombre y apellido de cada vendedor, cantidad de ventas y monto total vendido.
CREATE VIEW v_venta_por_vendedor AS
SELECT e.nombre, e.apellido, 
       COUNT(*) AS cantidad_ventas, 
       SUM(v.cantidad * v.precio_unitario) AS monto_total
FROM t_venta v 
INNER JOIN t_empleado e ON v.empleado_id = e.id
GROUP BY e.id, e.nombre, e.apellido;

SELECT * FROM v_venta_por_vendedor ORDER BY monto_total DESC;


